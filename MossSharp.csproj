<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- Documentation / analysis -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- XML docs can be enabled strictly later once the public API is stable. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <PackageId>MossSharp</PackageId>
    <Title>MossSharp</Title>
    <Description>Cross-platform .NET bindings for the Moss game framework.</Description>
    <Authors>TxbiG</Authors>
    <PackageTags>moss;gamedev;game-engine;graphics;audio;physics;networking;native-bindings;p-invoke</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TxbiG/MossSharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TxbiG/MossSharp</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version: override with /p:VersionSuffix=preview.1 or /p:Version=... in CI. -->
    <VersionPrefix>2.20.1</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''"></VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\moss.dll" 
          Pack="true" 
          PackagePath="runtimes\win-x64\native\" 
          CopyToOutputDirectory="PreserveNewest" />
          
    <None Include="runtimes\linux-x64\native\libmoss.so" 
          Pack="true" 
          PackagePath="runtimes\linux-x64\native\" 
          CopyToOutputDirectory="PreserveNewest" />
          
    <None Include="runtimes\osx-arm64\native\libmoss.dylib" 
          Pack="true" 
          PackagePath="runtimes\osx-arm64\native\" 
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
